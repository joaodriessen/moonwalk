root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,qml}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Inherited Windows packaging scaffolding (unbuilt/unmaintained by this fork) — leave untouched.
[{*.bat,*.ps1,*.sln,scripts/jom.exe,scripts/vswhere.exe}]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
